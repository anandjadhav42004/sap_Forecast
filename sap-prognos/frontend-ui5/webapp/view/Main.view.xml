<mvc:View
    controllerName="sap.prognos.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    displayBlock="true">
    
    <mvc:dependents>
        <ResponsivePopover
            id="profilePopover"
            title="User Profile &amp; Role"
            class="sapUiPopup-Std-Padding profilePopover"
            placement="Bottom"
            contentWidth="310px">
            <content>
                <VBox class="sapUiSmallMargin" alignItems="Center">
                    <HBox justifyContent="Center" alignItems="Center" class="avatarLarge sapUiSmallMarginBottom">
                        <Text text="{session>/avatarText}" class="avatarLargeText" />
                    </HBox>
                    <Title text="{session>/fullName}" level="H3" class="sapUiTinyMarginBottom" />
                    <Text text="{session>/email}" class="profileEmail sapUiSmallMarginBottom" />
                    
                    <ObjectStatus 
                        text="{session>/roleName}" 
                        state="{= ${session>/role} === 'admin' ? 'Information' : 'Warning' }" 
                        inverted="true" 
                        class="sapUiSmallMarginBottom" />
                    
                    <Panel class="profileInfoBox sapUiSmallMarginBottom" width="100%">
                        <VBox>
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text text="Access Level:" class="profileLabel" />
                                <Text text="{= ${session>/role} === 'admin' ? 'Full Control (Admin)' : 'Read-Only (Viewer)' }" class="profileValue" />
                            </HBox>
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text text="Permissions:" class="profileLabel" />
                                <Text text="{= ${session>/role} === 'admin' ? 'All Pages + PO Trigger' : 'Dashboard, Simulator, Analytics' }" class="profileValue" />
                            </HBox>
                        </VBox>
                    </Panel>
                    
                    <Button 
                        id="popoverLogoutBtn"
                        text="Logout" 
                        icon="sap-icon://log-out" 
                        type="Reject" 
                        width="100%" 
                        press=".onLogout" />
                </VBox>
            </content>
        </ResponsivePopover>
    </mvc:dependents>

    <tnt:ToolPage id="toolPage">
        <!-- Header -->
        <tnt:header>
            <tnt:ToolHeader class="navyHeader">
                <Button icon="sap-icon://menu2" type="Transparent" press=".onCollapseExpandPress" />
                <core:Icon src="sap-icon://line-chart" color="#ffffff" class="sapUiSmallMarginBegin" />
                <Title text="SAP Prognos — Demand Forecasting" class="headerTitle" />
                <ToolbarSpacer />
                <core:Icon src="sap-icon://bell" color="#ffffff" class="sapUiMediumMarginEnd bellIcon" />
                <ObjectStatus 
                    text="{= ${session>/role} === 'admin' ? 'ADMIN' : 'VIEWER' }" 
                    state="{= ${session>/role} === 'admin' ? 'Information' : 'Warning' }" 
                    inverted="true" 
                    class="sapUiSmallMarginEnd headerRoleBadge" />
                <Button id="avatarBtn" text="{session>/avatarText}" press=".onAvatarPress" class="avatarButton" tooltip="User Profile" />
            </tnt:ToolHeader>
        </tnt:header>
        
        <!-- Sidebar -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" itemSelect=".onSideNavSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="dashboard" text="Dashboard" icon="sap-icon://bbyd-dashboard" />
                    <tnt:NavigationListItem key="simulator" text="Simulator" icon="sap-icon://simulate" />
                    <tnt:NavigationListItem key="inventory" text="Inventory" icon="sap-icon://inventory" visible="{= ${session>/role} === 'admin' }" />
                    <tnt:NavigationListItem key="analytics" text="Analytics" icon="sap-icon://business-objects-experience" />
                    <tnt:NavigationListItem key="settings" text="Settings" icon="sap-icon://action-settings" visible="{= ${session>/role} === 'admin' }" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>
        
        <!-- Main Content -->
        <tnt:mainContents>
            <NavContainer id="pageContainer">
                <pages>
                    <!-- Page 1: Dashboard -->
                    <Page id="dashboard" showHeader="false">
                        <ScrollContainer horizontal="false" vertical="true" height="100%" class="mainContentBg">
                            <VBox class="dashboardContainer">
                            
                            <!-- Dashboard Header with Role Badge -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                <HBox alignItems="Center">
                                    <Title text="Executive Supply Chain Dashboard" level="H2" />
                                    <ObjectStatus 
                                        text="{= ${session>/role} === 'admin' ? 'Administrator (Full Access)' : 'Viewer (Read-Only Mode)' }" 
                                        state="{= ${session>/role} === 'admin' ? 'Information' : 'Warning' }" 
                                        inverted="true" 
                                        icon="{= ${session>/role} === 'admin' ? 'sap-icon://shield' : 'sap-icon://show' }"
                                        class="sapUiSmallMarginBegin" />
                                </HBox>
                                <Text text="{= ${session>/role} === 'admin' ? 'Full operational actions enabled' : 'Read-only monitoring mode' }" class="roleSubtitle" />
                            </HBox>
                            
                            <!-- KPI Strip -->
                            <HBox width="100%" class="sapUiSmallMarginBottom">
                                <VBox class="kpiTile sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Items tracked" class="kpiLabel" />
                                    <Title text="50" class="kpiValue" />
                                </VBox>
                                <VBox class="kpiTile sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Avg forecast accuracy" class="kpiLabel" />
                                    <Title text="{/accuracyAccuracy}" class="kpiValue" />
                                </VBox>
                                <VBox class="kpiTile sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Active reorder alerts" class="kpiLabel" />
                                    <Title text="{/reorderAlertsCount}" class="kpiValue" />
                                </VBox>
                                <VBox class="kpiTile">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Last updated" class="kpiLabel" />
                                    <Title id="lastUpdatedKpi" text="Just now" class="kpiValue" />
                                </VBox>
                            </HBox>

                            <!-- Reorder Alert Banner -->
                            <HBox class="alertBanner sapUiSmallMarginBottom" alignItems="Center" justifyContent="SpaceBetween">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://alert" color="#fbbf24" class="sapUiSmallMarginEnd" />
                                    <Text text="{/reorderAlertsCount} items are predicted to run low on stock this week — review recommended." class="alertText" />
                                </HBox>
                                <Button 
                                    id="reviewOrdersBtn"
                                    text="Review &amp; Approve Orders" 
                                    icon="sap-icon://order-status" 
                                    type="Emphasized" 
                                    press=".onQuickReviewOrders" 
                                    visible="{= ${session>/role} === 'admin' }" />
                            </HBox>

                            <!-- Input Row -->
                            <Panel class="cardPanel sapUiSmallMarginBottom">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                    <HBox alignItems="Center">
                                        <Label text="Store:" class="sapUiSmallMarginEnd" />
                                        <Select id="inputStore" selectedKey="{/store}" width="120px" class="sapUiMediumMarginEnd">
                                            <core:Item key="1" text="Store 1" />
                                            <core:Item key="2" text="Store 2" />
                                            <core:Item key="3" text="Store 3" />
                                            <core:Item key="4" text="Store 4" />
                                        </Select>
                                        
                                        <Label text="Item:" class="sapUiSmallMarginEnd" />
                                        <Select id="inputItem" selectedKey="{/item}" width="120px" class="sapUiMediumMarginEnd">
                                            <core:Item key="10" text="Item 10" />
                                            <core:Item key="15" text="Item 15" />
                                            <core:Item key="20" text="Item 20" />
                                            <core:Item key="25" text="Item 25" />
                                        </Select>
                                        
                                        <Label text="Forecast Date:" class="sapUiSmallMarginEnd" />
                                        <DatePicker id="inputDate" value="{/date}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" width="150px" class="sapUiMediumMarginEnd" />
                                    </HBox>
                                    <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                        <Label text="Sales Lag 1:" class="sapUiSmallMarginEnd" tooltip="Sales from 1 day ago" />
                                        <Input value="{/salesLag1}" type="Number" width="100px" class="sapUiMediumMarginEnd" />
                                        
                                        <Label text="Sales Lag 7:" class="sapUiSmallMarginEnd" tooltip="Sales from 7 days ago" />
                                        <Input value="{/salesLag7}" type="Number" width="100px" class="sapUiMediumMarginEnd" />
                                        
                                        <Label text="7-Day Rolling Mean:" class="sapUiSmallMarginEnd" tooltip="Average sales over the last 7 days" />
                                        <Input value="{/salesRollMean7}" type="Number" width="100px" class="sapUiMediumMarginEnd" />
                                    </HBox>
                                    <Button text="Get Forecast" type="Emphasized" press=".onGetForecast" busy="{/isBusy}" />
                                </HBox>
                            </Panel>
                            
                            <!-- Two Column Layout (Chart + Results) -->
                            <HBox width="100%" class="sapUiSmallMarginBottom">
                                <!-- Left Column: Chart -->
                                <VBox class="sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="7" baseSize="0%" /></layoutData>
                                    <Panel class="cardPanel" height="100%">
                                        <Text text="Actual vs Forecasted Sales" class="cardTitle sapUiSmallMarginBottom" />
                                        <core:HTML content="&lt;div style='height:350px; width:100%; position:relative; margin-top:1rem; z-index:1;'&gt;&lt;canvas id='forecastChart' style='position:absolute; left:0; top:0; width:100%; height:100%;'&gt;&lt;/canvas&gt;&lt;/div&gt;" />
                                    </Panel>
                                </VBox>
                                
                                <!-- Right Column: Result Cards -->
                                <VBox>
                                    <layoutData><FlexItemData growFactor="3" baseSize="0%" /></layoutData>
                                    <VBox class="highlightCard blueTint sapUiSmallMarginBottom" width="100%">
                                        <Text text="Forecasted demand" class="cardTitle blueText" />
                                        <HBox alignItems="Center" justifyContent="SpaceBetween">
                                            <Title id="resultText" text="{/forecastResult}" class="highlightValue blueText" />
                                            <BusyIndicator visible="{/isBusy}" />
                                        </HBox>
                                    </VBox>
                                    
                                    <VBox class="highlightCard tealTint sapUiSmallMarginBottom" width="100%">
                                        <Text text="Model accuracy (MAPE)" class="cardTitle tealText" />
                                        <Title text="{/accuracyMape}" class="highlightValue tealText" />
                                    </VBox>

                                    <VBox class="highlightCard" width="100%">
                                        <Text text="AI Drivers" class="cardTitle" />
                                        <VBox items="{/explainability}">
                                            <HBox justifyContent="SpaceBetween" width="100%" class="sapUiTinyMarginBottom">
                                                <Text text="{factor}" />
                                                <ObjectStatus text="{impact_percentage}%" state="{= ${direction} === 'up' ? 'Success' : 'Error' }" icon="{= ${direction} === 'up' ? 'sap-icon://trend-up' : 'sap-icon://trend-down' }" />
                                            </HBox>
                                        </VBox>
                                    </VBox>
                                </VBox>
                            </HBox>
                            
                            <!-- Top Forecasted Items Table -->
                            <Panel class="cardPanel sapUiSmallMarginBottom">
                                <Text text="Items Requiring Reorder (Top 10 Critical)" class="cardTitle sapUiSmallMarginBottom" />
                                <Table items="{/reorderAlerts}" noDataText="No critical reorders needed">
                                    <columns>
                                        <Column>
                                            <Text text="Location / Item" />
                                        </Column>
                                        <Column hAlign="End">
                                            <Text text="Current Stock" />
                                        </Column>
                                        <Column hAlign="Center">
                                            <Text text="Safety Stock" />
                                        </Column>
                                        <Column hAlign="Center">
                                            <Text text="Status" />
                                        </Column>
                                        <Column hAlign="Center" visible="{= ${session>/role} === 'admin' }">
                                            <Text text="Admin Action" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="Store {store} — Item {item}" />
                                                <Text text="{currentStock} units" />
                                                <Text text="{safetyStock} units" />
                                                <ObjectStatus text="{statusText}" state="{trendColor}" icon="{trendIcon}" />
                                                <Button 
                                                    text="Trigger PO" 
                                                    icon="sap-icon://cart" 
                                                    type="Emphasized" 
                                                    press=".onTriggerPO" 
                                                    visible="{= ${session>/role} === 'admin' }" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                            
                            <!-- Bottom Stat Tiles Row -->
                            <HBox width="100%">
                                <VBox class="statTile sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Baseline" class="tileTitle" />
                                    <Title text="{/baselineMape}" class="tileValue" />
                                    <Text text="MAPE" class="tileMetric" />
                                </VBox>
                                <VBox class="statTile sapUiSmallMarginEnd">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="Prophet" class="tileTitle" />
                                    <Title text="{/prophetMape}" class="tileValue" />
                                    <Text text="MAPE" class="tileMetric" />
                                </VBox>
                                <VBox class="statTile activeTile">
                                    <layoutData><FlexItemData growFactor="1" baseSize="0%" /></layoutData>
                                    <Text text="XGBoost" class="tileTitle" />
                                    <Title text="{/accuracyMape}" class="tileValue" />
                                    <Text text="MAPE" class="tileMetric" />
                                </VBox>
                            </HBox>

                        </VBox>
                    </ScrollContainer>
                    </Page>
                    
                    
                    <!-- Page: Simulator -->
                    <Page id="simulator" showHeader="false">
                        <ScrollContainer horizontal="false" vertical="true" height="100%" class="mainContentBg">
                            <VBox class="dashboardContainer">
                                <Title text="What-If Demand Simulator" level="H2" class="sapUiMediumMarginBottom" />
                                
                                <Panel class="cardPanel sapUiSmallMarginBottom">
                                    <VBox>
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Label text="Store:" class="sapUiSmallMarginEnd" width="100px" />
                                            <Select selectedKey="{/simStore}" width="150px">
                                                <core:Item key="1" text="Store 1" />
                                                <core:Item key="2" text="Store 2" />
                                            </Select>
                                        </HBox>
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Label text="Item:" class="sapUiSmallMarginEnd" width="100px" />
                                            <Select selectedKey="{/simItem}" width="150px">
                                                <core:Item key="10" text="Item 10" />
                                                <core:Item key="15" text="Item 15" />
                                            </Select>
                                        </HBox>
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Label text="Demand Adjust:" class="sapUiSmallMarginEnd" width="100px" />
                                            <Slider value="{/simDemandAdjust}" min="-50" max="100" showAdvancedTooltip="true" width="300px" class="sapUiSmallMarginEnd" />
                                            <Text text="{/simDemandAdjust}%" />
                                        </HBox>
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Label text="Promotion:" class="sapUiSmallMarginEnd" width="100px" />
                                            <Switch state="{/simPromotion}" customTextOn="Yes" customTextOff="No" />
                                        </HBox>
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Label text="High Season:" class="sapUiSmallMarginEnd" width="100px" />
                                            <Switch state="{/simSeasonality}" customTextOn="Yes" customTextOff="No" />
                                        </HBox>
                                        
                                        <Button text="Run Simulation" type="Emphasized" press=".onRunSimulation" busy="{/isBusy}" class="sapUiMediumMarginTop" />
                                    </VBox>
                                </Panel>
                                
                                <HBox width="100%">
                                    <VBox class="highlightCard blueTint sapUiSmallMarginEnd" width="50%">
                                        <Text text="Current Forecast" class="cardTitle blueText" />
                                        <Title text="{/simCurrentForecast}" class="highlightValue blueText" />
                                    </VBox>
                                    <VBox class="highlightCard tealTint" width="50%">
                                        <Text text="Simulated Forecast" class="cardTitle tealText" />
                                        <Title text="{/simSimulatedForecast}" class="highlightValue tealText" />
                                    </VBox>
                                </HBox>
                                
                                <Panel class="cardPanel sapUiSmallMarginTop">
                                    <Text text="Inventory Recommendation" class="cardTitle sapUiSmallMarginBottom" />
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://inventory" size="2rem" class="sapUiMediumMarginEnd" color="#64748b" />
                                        <VBox>
                                            <Text text="Inventory Impact: {/simInventoryImpact} units" />
                                            <ObjectStatus text="{= ${/simRecommendedOrder} > 0 ? '⚠️ Reorder ' + ${/simRecommendedOrder} + ' units' : '✅ Stock Sufficient' }" state="{= ${/simRecommendedOrder} > 0 ? 'Warning' : 'Success' }" class="sapUiSmallMarginTop" />
                                        </VBox>
                                    </HBox>
                                </Panel>
                                
                            </VBox>
                        </ScrollContainer>
                    </Page>

                    <!-- Page 2: Inventory -->
                    <Page id="inventory" showHeader="false">
                        <ScrollContainer horizontal="false" vertical="true" height="100%" class="mainContentBg">
                            <VBox class="dashboardContainer">
                                <Title text="Inventory Overview &amp; Risk Analysis" level="H2" class="sapUiMediumMarginBottom" />
                                <Panel class="cardPanel">
                                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                        <SearchField placeholder="Search by Store or Item..." width="300px" liveChange=".onInventorySearch" />
                                        <Button text="Refresh" icon="sap-icon://refresh" press=".onRefreshInventory" />
                                    </HBox>
                                    <Table id="inventoryTable" items="{/fullInventory}" noDataText="Loading inventory data...">
                                        <columns>
                                            <Column><Text text="Store" /></Column>
                                            <Column><Text text="Item" /></Column>
                                            <Column hAlign="End"><Text text="Current Stock" /></Column>
                                            <Column hAlign="End"><Text text="Incoming" /></Column>
                                            <Column hAlign="End"><Text text="Target Stock" /></Column>
                                            <Column hAlign="End"><Text text="Days Cover" /></Column>
                                            <Column hAlign="Center"><Text text="Status" /></Column>
                                            <Column hAlign="End"><Text text="Recommended Order" /></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Text text="{store}" />
                                                    <Text text="{item}" />
                                                    <Text text="{current_stock}" />
                                                    <Text text="{incoming_stock}" />
                                                    <Text text="{target_stock}" />
                                                    <Text text="{days_of_cover}" />
                                                    <ObjectStatus text="{risk}" state="{= ${risk} === 'CRITICAL' ? 'Error' : (${risk} === 'HIGH' ? 'Warning' : (${risk} === 'MEDIUM' ? 'Information' : 'Success'))}" icon="{= ${risk} === 'CRITICAL' ? 'sap-icon://error' : (${risk} === 'HIGH' ? 'sap-icon://warning2' : 'sap-icon://sys-enter-2')}" />
                                                    <Text text="{recommended_order}" />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </Panel>
                            </VBox>
                        </ScrollContainer>
                    </Page>
                    
                    <!-- Page 3: Analytics -->
                    <Page id="analytics" showHeader="false">
                        <ScrollContainer horizontal="false" vertical="true" height="100%" class="mainContentBg">
                            <VBox class="dashboardContainer">
                                <Title text="Advanced Analytics &amp; Model Performance" level="H2" class="sapUiMediumMarginBottom" />
                                <HBox width="100%">
                                    <VBox width="50%" class="sapUiSmallMarginEnd">
                                        <Panel class="cardPanel" height="100%">
                                            <Text text="Model Benchmark (MAPE %)" class="cardTitle sapUiSmallMarginBottom" />
                                            <VBox class="sapUiSmallMarginTop">
                                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                                    <Text text="Baseline (7-Day MA)" />
                                                    <Text text="{/baselineMape}" class="errorText" />
                                                </HBox>
                                                <ProgressIndicator percentValue="{= parseFloat(${/baselineMape}) }" displayValue="{/baselineMape}" state="Error" />
                                                
                                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom sapUiSmallMarginTop">
                                                    <Text text="Prophet (Sampled)" />
                                                    <Text text="{/prophetMape}" class="warningText" />
                                                </HBox>
                                                <ProgressIndicator percentValue="{= parseFloat(${/prophetMape}) }" displayValue="{/prophetMape}" state="Warning" />
                                                
                                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom sapUiSmallMarginTop">
                                                    <Text text="XGBoost (Production)" />
                                                    <Text text="{/accuracyMape}" class="successText" />
                                                </HBox>
                                                <ProgressIndicator percentValue="{= parseFloat(${/accuracyMape}) }" displayValue="{/accuracyMape}" state="Success" />
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                    <VBox width="50%">
                                        <Panel class="cardPanel" height="100%">
                                            <Text text="Anomaly Detection Prototype" class="cardTitle sapUiSmallMarginBottom" />
                                            <Text text="Detects sales spikes/dips > 2 std deviations" class="sapUiSmallMarginBottom sapUiTinyMarginTop" />
                                            <Button text="Run Anomaly Scan (Demo Store 2/Item 10)" type="Emphasized" press=".onRunAnomalies" busy="{/isBusyAnomalies}" />
                                            <VBox id="anomalyResults" class="sapUiSmallMarginTop" visible="{= ${/anomalies}.length > 0 }">
                                                <Text text="Found {/anomaliesCount} anomalies in recent history." class="warningText sapUiSmallMarginBottom" />
                                                <List items="{/anomalies}">
                                                    <StandardListItem title="Date: {date}" description="Expected: {expected} | Actual: {actual_sales} ({deviation_pct}%)" icon="{= ${is_spike} ? 'sap-icon://trend-up' : 'sap-icon://trend-down'}" infoState="{= ${is_spike} ? 'Success' : 'Error'}" />
                                                </List>
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </ScrollContainer>
                    </Page>

                    <!-- Page 4: Settings & Diagnostics -->
                    <Page id="settings" showHeader="false">
                        <ScrollContainer horizontal="false" vertical="true" height="100%" class="mainContentBg">
                            <VBox class="dashboardContainer">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiMediumMarginBottom">
                                    <HBox alignItems="Center">
                                        <Title text="System Settings &amp; Model Diagnostics" level="H2" />
                                        <ObjectStatus text="Admin Operational Console" state="Information" inverted="true" class="sapUiSmallMarginBegin" />
                                    </HBox>
                                    <Button text="Refresh Health" icon="sap-icon://refresh" press=".onRefreshHealth" />
                                </HBox>

                                <!-- Grid of Settings / Diagnostics Cards -->
                                <HBox width="100%" class="sapUiSmallMarginBottom">
                                    <!-- Card 1: ML Model Spec -->
                                    <VBox width="50%" class="sapUiSmallMarginEnd">
                                        <Panel class="settingsCard" height="100%">
                                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                <core:Icon src="sap-icon://machine-learning" color="#60a5fa" class="sapUiSmallMarginEnd" />
                                                <Text text="Machine Learning Specifications" class="cardTitle" />
                                            </HBox>
                                            <VBox class="sapUiTinyMarginTop">
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Production Model:" class="profileLabel" />
                                                    <Text text="XGBoost Regressor (Multi-Series)" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Deployed Version:" class="profileLabel" />
                                                    <Text text="XGBoost v1.0.0 (Production Stable)" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Engineered Features:" class="profileLabel" />
                                                    <Text text="9 Features (Lags 1,7, RollMean 7, Calendar)" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Uncertainty Quantification:" class="profileLabel" />
                                                    <Text text="Empirical Residual Bands (85% CI)" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Granularity:" class="profileLabel" />
                                                    <Text text="Daily Store-Item Level (Hierarchical)" class="profileValue" />
                                                </HBox>
                                            </VBox>
                                        </Panel>
                                    </VBox>

                                    <!-- Card 2: Live Backend Microservice Health -->
                                    <VBox width="50%">
                                        <Panel class="settingsCard" height="100%">
                                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                <core:Icon src="sap-icon://connected" color="#34d399" class="sapUiSmallMarginEnd" />
                                                <Text text="Microservice Health &amp; Runtime" class="cardTitle" />
                                            </HBox>
                                            <VBox class="sapUiTinyMarginTop">
                                                <HBox justifyContent="SpaceBetween" class="settingsRow" alignItems="Center">
                                                    <Text text="Backend API Status:" class="profileLabel" />
                                                    <ObjectStatus text="{/backendStatus}" state="{/backendStatusState}" inverted="true" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Model State in Memory:" class="profileLabel" />
                                                    <Text text="{/backendModelLoaded}" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Database Engine:" class="profileLabel" />
                                                    <Text text="{/backendDbConnected}" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="FastAPI Microservice:" class="profileLabel" />
                                                    <Text text="Port 8000 (FastAPI v{/backendVersion})" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="OpenAPI Documentation:" class="profileLabel" />
                                                    <Text text="Available at /docs &amp; /openapi.json" class="profileValue" />
                                                </HBox>
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                </HBox>

                                <HBox width="100%">
                                    <!-- Card 3: Benchmark Accuracy Summary -->
                                    <VBox width="50%" class="sapUiSmallMarginEnd">
                                        <Panel class="settingsCard" height="100%">
                                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                <core:Icon src="sap-icon://performance" color="#a78bfa" class="sapUiSmallMarginEnd" />
                                                <Text text="Benchmark &amp; Accuracy Metrics" class="cardTitle" />
                                            </HBox>
                                            <VBox class="sapUiTinyMarginTop">
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Production XGBoost MAPE:" class="profileLabel" />
                                                    <Text text="{/accuracyMape} (Leader)" class="successText" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Prophet Benchmark MAPE:" class="profileLabel" />
                                                    <Text text="{/prophetMape}" class="warningText" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Baseline 7-Day MA MAPE:" class="profileLabel" />
                                                    <Text text="{/baselineMape}" class="errorText" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Model Lift Over Baseline:" class="profileLabel" />
                                                    <Text text="+60.8% Error Reduction" class="profileValue" />
                                                </HBox>
                                            </VBox>
                                        </Panel>
                                    </VBox>

                                    <!-- Card 4: Enterprise Identity & RBAC Info -->
                                    <VBox width="50%">
                                        <Panel class="settingsCard" height="100%">
                                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                <core:Icon src="sap-icon://user-settings" color="#f59e0b" class="sapUiSmallMarginEnd" />
                                                <Text text="Active Identity &amp; RBAC Control" class="cardTitle" />
                                            </HBox>
                                            <VBox class="sapUiTinyMarginTop">
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Authenticated User:" class="profileLabel" />
                                                    <Text text="{session>/fullName} ({session>/username})" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Contact Email:" class="profileLabel" />
                                                    <Text text="{session>/email}" class="profileValue" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Role Clearance:" class="profileLabel" />
                                                    <ObjectStatus text="{session>/roleName}" state="Information" inverted="true" />
                                                </HBox>
                                                <HBox justifyContent="SpaceBetween" class="settingsRow">
                                                    <Text text="Access Permissions:" class="profileLabel" />
                                                    <Text text="Full R/W, PO Trigger, Analytics, Config" class="profileValue" />
                                                </HBox>
                                            </VBox>
                                        </Panel>
                                    </VBox>
                                </HBox>

                            </VBox>
                        </ScrollContainer>
                    </Page>

                </pages>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
