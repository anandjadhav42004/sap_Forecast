<mvc:View
    controllerName="sap.prognos.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true">

    <Page showHeader="false" id="loginPage" class="fioriLoginPage">
        <content>
            <VBox alignItems="Center" justifyContent="Center" class="loginContainer">

                <!-- Main Card -->
                <VBox class="loginCardPanel" width="100%">
                    
                    <!-- Header Branding -->
                    <VBox alignItems="Center" class="loginHeaderBox">
                        <Image src="img/sap_prognos_logo.svg" width="68px" height="68px" class="sapUiSmallMarginBottom" />
                        <Title level="H1" text="SAP Prognos" class="loginAppTitle" />
                        <Text text="AI Demand Forecasting &amp; Inventory Intelligence" class="loginAppSub" />
                    </VBox>

                    <!-- Role Switcher -->
                    <VBox class="roleSelectorBox">
                        <Label text="SELECT ACCESS MODE" class="fieldLabel" />
                        <SegmentedButton id="roleSelector" selectedKey="{/selectedRole}" select=".onRoleChange" width="100%">
                            <items>
                                <SegmentedButtonItem key="admin" text="Administrator" icon="sap-icon://shield" />
                                <SegmentedButtonItem key="user"  text="Viewer Mode"   icon="sap-icon://user-settings" />
                            </items>
                        </SegmentedButton>
                    </VBox>

                    <!-- Quick Credential Badge -->
                    <HBox class="credHintBox" alignItems="Center" justifyContent="SpaceBetween" press=".onFillCredentials">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://key" class="credHintIcon sapUiTinyMarginEnd" />
                            <Text text="{/credHintText}" class="credHintText" />
                        </HBox>
                        <Button text="Auto-fill" type="Transparent" press=".onFillCredentials" class="autoFillBtn" />
                    </HBox>

                    <!-- Error Alert Strip -->
                    <MessageStrip
                        id="loginErrorStrip"
                        text="{/errorMessage}"
                        type="Error"
                        showIcon="true"
                        visible="{/hasError}"
                        class="sapUiSmallMarginBottom" />

                    <!-- Inputs Form -->
                    <VBox class="loginFormBox">
                        <Label text="USERNAME" required="true" class="fieldLabel" />
                        <Input 
                            id="usernameInput" 
                            placeholder="Enter username" 
                            value="{/username}" 
                            width="100%" 
                            submit=".onLogin"
                            class="loginInput" />

                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                            <Label text="PASSWORD" required="true" class="fieldLabel" />
                            <Button 
                                id="togglePasswordBtn" 
                                icon="{= ${/isPasswordMasked} ? 'sap-icon://show' : 'sap-icon://hide' }" 
                                type="Transparent" 
                                tooltip="Toggle Password Visibility"
                                press=".onTogglePassword" 
                                class="togglePassBtn" />
                        </HBox>
                        <Input 
                            id="passwordInput" 
                            placeholder="Enter password" 
                            type="{= ${/isPasswordMasked} ? 'Password' : 'Text' }" 
                            value="{/password}" 
                            width="100%" 
                            submit=".onLogin"
                            class="loginInput" />

                        <Button 
                            id="submitLoginBtn" 
                            text="{= ${/selectedRole} === 'admin' ? 'Sign In as Administrator' : 'Sign In as Viewer' }" 
                            type="Emphasized" 
                            press=".onLogin" 
                            width="100%" 
                            busy="{/isAuthenticating}"
                            class="submitLoginButton" />
                    </VBox>

                    <!-- Role Permissions Preview -->
                    <Panel expandable="true" expanded="false" headerText="Role Capabilities &amp; Permissions" class="permPanel">
                        <VBox class="permList">
                            <HBox alignItems="Center" class="permItem">
                                <core:Icon src="sap-icon://accept" class="permIconYes" />
                                <Text text="XGBoost &amp; Prophet Demand Forecasting" class="permText" />
                            </HBox>
                            <HBox alignItems="Center" class="permItem">
                                <core:Icon src="sap-icon://accept" class="permIconYes" />
                                <Text text="Inventory Stock Levels &amp; Risk Analytics" class="permText" />
                            </HBox>
                            <HBox alignItems="Center" class="permItem">
                                <core:Icon src="sap-icon://accept" class="permIconYes" />
                                <Text text="What-If Simulation &amp; Demand Scenarios" class="permText" />
                            </HBox>
                            <HBox alignItems="Center" class="permItem">
                                <core:Icon 
                                    src="{= ${/selectedRole} === 'admin' ? 'sap-icon://accept' : 'sap-icon://decline' }" 
                                    class="{= ${/selectedRole} === 'admin' ? 'permIconYes' : 'permIconNo' }" />
                                <Text 
                                    text="Automated Purchase Order Creation (Admin Only)" 
                                    class="{= ${/selectedRole} === 'admin' ? 'permText' : 'permTextDisabled' }" />
                            </HBox>
                        </VBox>
                    </Panel>

                    <!-- Footer -->
                    <HBox justifyContent="Center" class="loginFooter">
                        <Text text="SAP Fiori Horizon Dark Edition · Enterprise AI Platform" class="footerText" />
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
