{
  "_version": "1.32.0",
  "sap.app": {
    "id": "sap.prognos",
    "type": "application",
    "title": "SAP Prognos",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://line-chart"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.prognos.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "models": {
      "": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "sap.prognos.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "login",
          "target": "login"
        },
        {
          "pattern": "main",
          "name": "main",
          "target": "main"
        }
      ],
      "targets": {
        "login": {
          "viewId": "login",
          "viewName": "Login"
        },
        "main": {
          "viewId": "main",
          "viewName": "Main"
        }
      }
    }
  }
}
